# Địa chỉ phải truy cập được từ điện thoại. Không dùng localhost khi backend chạy trên máy tính khác.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8080/ws

# ID EAS public, không phải credential. Để trống cho tới khi liên kết dự án EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Cho phép HTTP/WS tới backend LAN trong development/preview. Rebuild nếu đổi.
# Production dùng HTTPS/WSS và APP_ALLOW_HTTP=false.
APP_ALLOW_HTTP=true

# Tùy chọn khi build Android native map/push; không cần cho web/unit test.
# Maps key nên giới hạn theo Android package/signing certificate.
ANDROID_MAPS_API_KEY=
# File credential local hoặc biến EAS kiểu File; không commit file này.
GOOGLE_SERVICES_JSON=
