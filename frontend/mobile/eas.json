{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": { "APP_ALLOW_HTTP": "true" },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "env": { "APP_ALLOW_HTTP": "true" },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": { "APP_ALLOW_HTTP": "false" },
      "autoIncrement": true
    }
  }
}
