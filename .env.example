# Copy to deployment/.env for Docker. Fill secrets locally; do not commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Classroom: optional authenticated MQTT listener inside the backend JAR.
MQTT_EMBEDDED_ENABLED=false
MQTT_EMBEDDED_HOST=0.0.0.0
MQTT_EMBEDDED_PORT=1883
MQTT_PUBLIC_HOST=192.168.1.10
DEMO_DEVICE_MQTT_PASSWORD=
DEMO_HARDWARE_UNCLAIMED=false
COMMAND_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_TIMEOUT_SECONDS=45
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Native push is opt-in; requires a configured EAS project and FCM/APNs.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
PUSH_RECEIPT_POLL_MS=60000

# Used by frontend/mobile/.env; replace the example LAN address for your machine.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8080/ws
EXPO_PUBLIC_EAS_PROJECT_ID=
APP_ALLOW_HTTP=true
ANDROID_MAPS_API_KEY=
GOOGLE_SERVICES_JSON=

# Optional Vite development proxy, read by the shell running npm run dev.
BACKEND_URL=http://127.0.0.1:8080
# Optional Vite HTTPS certificate/key paths, generated locally; never commit private keys.
GUARDIAN_HTTPS_CERT_FILE=
GUARDIAN_HTTPS_KEY_FILE=
