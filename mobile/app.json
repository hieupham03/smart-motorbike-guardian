{
  "expo": {
    "name": "Smart Motorbike Guardian",
    "slug": "smart-motorbike-guardian",
    "scheme": "guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guardian.smartmotorbike"
    },
    "android": {
      "package": "com.guardian.smartmotorbike",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cho phép Smart Motorbike Guardian sử dụng Face ID để bảo vệ phiên đăng nhập."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Smart Motorbike Guardian dùng camera để quét mã thiết bị."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
