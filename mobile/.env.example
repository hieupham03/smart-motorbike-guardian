# Địa chỉ phải truy cập được từ điện thoại. Không dùng localhost khi backend chạy trên máy tính khác.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8080/ws

# ID EAS public, không phải credential. Để trống cho tới khi liên kết dự án EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=
