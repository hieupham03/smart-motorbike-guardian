# Copy to deployment/.env and fill locally; never commit credentials.
POSTGRES_PASSWORD=
# At least 32 random bytes/characters, generated locally.
JWT_SECRET=
MQTT_BROKER_URL=tcp://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=
COMMAND_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_TIMEOUT_SECONDS=45
# Chỉ cần khi đã bật Expo push access security; không commit giá trị thật.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENABLED=true
PUSH_RECEIPT_POLL_MS=60000
